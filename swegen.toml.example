# Central SWE-gen configuration. Copy to ./swegen.toml before running SWE-gen.
# API keys, credentials, endpoints, and model names are intentionally read only
# from this file; inherited shell/.env values are ignored.

[orchestrator]
# Optional successful-instance target for one run. When omitted, SWE-gen keeps
# processing until no eligible database rows remain.
# produce_count = 100

[database]
# PostgreSQL database containing the qualified swegen.pr_tasks relation.
host = "localhost"
port = 5432
database = "mindforge"
user = "postgres"
password = "Repomind@123"
table = "swegen.pr_tasks"
# A row is eligible while COALESCE(swegen_retries, 0) is below this value.
# Lower-retry PRs are allocated before higher-retry PRs.
max-retries = 3
# Case-insensitive primary_language values that must never be allocated.
exclude_languages = []
# Case-insensitive pr_category values that are eligible. Defaults to feature.
pr_category = ["feature"]
connect_timeout = 10

[github]
# A token is selected from this pool for GitHub API/clone work.
gh_tokens = [
    "ghp_replace_me",
]

[model]
# Claude Agent SDK / Claude Code task-generation model and authentication.
model = "qwen3.5-397b-a17b-alex-swe-gen"
base_url = "https://replace-with-claude-compatible-endpoint"
api_key = "replace_me"
# Instead of api_key, deployments may configure one of these in this file:
# auth_token = "replace_me"
# oauth_token = "replace_me"

[openai]
# OpenAI-compatible endpoint used for PR instruction generation and verdicts.
api_key = "replace_me"
base_url = "https://replace-with-openai-compatible-endpoint/v1"
task_instruction_model = "coder-GLM-51"
verdict_model = "coder-GLM-51"

[analysis]
classifier_model = "claude-sonnet-4-5"
agent_model = "anthropic/claude-sonnet-4-5"

[timeouts]
# The database lease for a repository group is:
#   sum(all values below) * lease_fraction
task_instruction = 90
docker_build = 600
claude_code = 3200
harbor_nop = 600
harbor_oracle = 600
hacking_check = 600
swr_upload = 1800
lease_fraction = 0.1

[hacking]
# Every configured checker must return is_hacking=false for the task to pass.
[[hacking.llm]]
name = "primary"
endpoint = "https://replace-with-openai-compatible-endpoint"
model = "replace-with-hacking-checker-model"
api_key = "replace_me"

[swr]
# Successful non-hacking images are tagged as:
# <registry>/<repository>:<tag_prefix><instance_id>
enabled = true
registry = "swr-coder-data-trajectory-o84wch.swr-pro.myhuaweicloud.com"
repository = "aifm.coder.exp/swegen/generated"
username = "replace_me"
password = "replace_me"
tag_prefix = ""
retries = 3
push_timeout = 1800
