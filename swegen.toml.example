# swegen.toml — optional configuration for the Claude Code task-generation runner.
#
# Copy this file to `swegen.toml` in the directory you run swegen from (or point
# the SWEGEN_CONFIG env var at it) to pick the model and inference endpoint used
# by the create/farm pipeline.
#
# Precedence (highest first):
#   1. Environment variables  (ANTHROPIC_MODEL, ANTHROPIC_BASE_URL)
#   2. This file
#   3. Built-in defaults
#
# Every key is optional; omit a key to fall back to the next source.

[model]
# Model name passed to the Claude Code SDK.
# Overridden by the ANTHROPIC_MODEL env var if set.
model = "qwen3.5-397b-a17b-alex-swe-gen"

# Inference endpoint (sets ANTHROPIC_BASE_URL for the SDK subprocess).
# Overridden by the ANTHROPIC_BASE_URL env var if set.
# Leave commented out to use the SDK/CLI default endpoint.
# base_url = "https://my-inference-endpoint/v1"

[github]
# GitHub token used by the orchestrator to look up linked issue numbers for
# task metadata. Precedence: --github-token flag > GITHUB_TOKEN env var > this.
# token = "ghp_..."

# Pool of GitHub tokens the orchestrator rotates between for cloning and API
# lookups. A token is chosen at random per task; on a rate-limit/forbidden
# error (HTTP 429/403) the run is retried with a different token from the pool.
# Takes precedence over `token` when set. An explicit --github-token flag or a
# GITHUB_TOKEN env var overrides the pool entirely.
# gh_tokens = [
#     "ghp_...",
#     "ghp_...",
# ]
