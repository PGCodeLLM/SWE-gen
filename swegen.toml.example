# SWE-gen runtime configuration.
#
# Copy this file to swegen.toml and replace every placeholder.  For model
# endpoints, model names, and API credentials, this file is authoritative:
# inherited environment variables and CLI model/key overrides are ignored.

[model]
# Claude Agent SDK / Claude Code-compatible endpoint used for task generation.
model = "qwen3.5-397b-a17b-alex-swe-gen"
base_url = "https://model-endpoint.example"
api_key = "replace-me"
fast_model = "gpt-5.3-codex-spark"
opus_model = "qwen3.5-397b-a17b-alex-swe-gen"
sonnet_model = "qwen3.5-397b-a17b-alex-swe-gen"
reasoning_effort = "high"

[openai]
# OpenAI-compatible endpoint used for task instructions and analysis verdicts.
base_url = "https://openai-compatible-endpoint.example/v1"
api_key = "replace-me"
task_instruction_model = "gpt-5.6-terra"
verdict_model = "gpt-5.6-terra"

[analysis]
# Harbor agent trials and Claude-based trial classification.
agent_model = "gpt-5.6-sol"
classifier_model = "gpt-5.6-sol"

[github]
# A token is selected from this pool for each process/task.
gh_tokens = [
  "ghp_replace_me",
]

[[hacking.llm]]
name = "primary"
endpoint = "https://reward-checker.example"
model = "gpt-5.6-sol"
api_key = "replace-me"

[pipeline]
namespace = "swegen-pipeline-tester"
secret_source_namespace = "swegen-pipeline"
worker_image = "swegen-worker:arthur-tester-20260731"
workspace_host_path = "/data/swegen-k3s-tester/workspaces"
repo_cache_host_path = "/data/swegen-k3s-tester/cache"
successful_tasks_host_path = "/data/swegen-k3s-tester/successful-harbor-tasks"
k3s_nodes = ["7.244.3.78", "7.244.3.200", "7.244.2.110", "7.244.1.209"]
k3s_ssh_user = "root"
build_ca_path = "/etc/ssl/certs/ca-certificates.crt"
build_worker_image_on_start = true
autoqueue_workers = 1
generate_workers = 48
validate_workers = 168
reward_workers = 16
push_workers = 1
rollout_timeout_seconds = 1800

[autoqueue]
source_table = "public.pr_tasks"
# An explicit max_queued has priority over the per-worker calculation.
# max_queued = 100
max_queued_per_generate_worker = 1.5
poll_seconds = 30.0
task_version = 1
max_retries = 3
pr_categories = ["feature"]
exclude_languages = []

[swr.primary]
host = "swr-coder-data-platform-wce1sr.swr-pro.myhuaweicloud.com"
repository = "swesandbox/public/swe-gen/feature-implementation/generated"
registry = "platform"
suffix = "_platform"

[swr.minddistiller]
host = "swr-coder-data-trajectory-o84wch.swr-pro.myhuaweicloud.com"
repository = "aifm.coder.exp/swegen/generated"
registry = "trajectory"
suffix = ""
username = "replace-me"
password = "replace-me"

[completed_tasks]
output_dir = "/app/data_cache/successful_harbor_tasks"
